# ==============================================================================
# PERCEPTA DEFENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# Supports Cloud-Hybrid Online C2 and Edge/Offline Deployments
# ==============================================================================

# Core Application Settings
APP_NAME="PERCEPTA Defence C2"
APP_ENV=production                  # development | production | testing
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_VERSION=v1
CORS_ORIGINS=https://percepta-c2.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL for Online Cloud)
# ------------------------------------------------------------------------------
# Neon Free PostgreSQL connection string:
# Format: postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://percepta_user:secret_password@ep-sample-12345.us-east-2.aws.neon.tech/percepta_cloud?ssl=require

# Local/Offline fallback:
# DATABASE_URL=sqlite+aiosqlite:///./percepta.db

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION (Free Tier)
# ------------------------------------------------------------------------------
# Public credentials (Safe for Frontend and Backend):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Backend-Only Supabase Configuration (DO NOT EXPOSE TO FRONTEND):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.backend-only-service-role-key-never-share
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# ------------------------------------------------------------------------------
# 3. FRONTEND PRODUCTION URLS (Vercel)
# ------------------------------------------------------------------------------
VITE_API_URL=https://percepta-backend.onrender.com
VITE_WS_URL=wss://percepta-backend.onrender.com/ws/events

# ------------------------------------------------------------------------------
# 4. EVIDENCE STORAGE & RETENTION POLICIES
# ------------------------------------------------------------------------------
# Options: local | cloud (Supabase Storage / S3-compatible)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
EVIDENCE_DIR=./storage/evidence
SNAPSHOTS_DIR=./storage/snapshots
UPLOAD_DIR=./storage/uploads

# Raw surveillance footage retention before auto-purge (Hours: 2, 3, 6, 12, 24)
# Forensic incident evidence is permanently preserved and immune to raw purge.
RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# 5. ASYNCHRONOUS JOB QUEUE & WORKERS
# ------------------------------------------------------------------------------
QUEUE_CONCURRENCY=4
MAX_JOB_RETRIES=3

# ------------------------------------------------------------------------------
# 6. VISION & PERCEPTION ENGINE (Edge Node)
# ------------------------------------------------------------------------------
YOLO_MODEL_NAME=yolov8n.pt
AUTOSTART_DEMO_CAMERA=false
DEFAULT_DEMO_CLIP=virat_cctv.mp4

# ------------------------------------------------------------------------------
# 7. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_random_64_char_hex_secret_here
DEMO_MODE=false                     # Set to false for strict JWT auth in production
